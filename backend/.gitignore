# Virtual Environments & Python Cache
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Environment Variables & API Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Ephemeral Jobs & Worker Pipelines
jobs/
output/
output_scene/
out/
temp/
tmp/

# Generated compositor artefacts (regenerated by scripts/render_fixture_demo.py
# and compositor/typography.py --selftest)
assets/fonts/_selftest.png
tests/fixtures/audio/

# Generated Media Deliverables
*.mp4
*.mp3
*.wav
*.aac
*.srt
*.vtt
static/videos/*
static/audio/*
static/font_tests/*
!static/videos/.gitkeep
!static/audio/.gitkeep

# Presenter avatar loops are inputs, not generated deliverables: the tests and
# the documented try-it path both need placeholder_m01.mp4 present.
!assets/avatars/*.mp4

# Images pulled from the web by services/image_fetcher.py, and the cached
# search responses that found them. These are other people's pictures held
# under whatever licence the publisher declared — they are a local cache, not
# project assets, and must not be redistributed through this repository. The
# .source.json sidecars go with them; provenance is only meaningful next to
# the file it describes.
assets/broll/fetched/
assets/broll/.search_cache/

# Same reasoning for the offline image library scripts/build_image_library.py
# seeds from Wikimedia Commons: real photographs under real people's licences,
# not something this project should mirror as tracked binaries. Re-seed with
# `python scripts/build_image_library.py`, then eyeball the contact sheet it
# writes before trusting anything it found — no automated filter can confirm
# README §10.3's "no identifiable faces" the way a person looking at it can.
assets/broll/library/

# Local Uploads & Raw PDFs
uploads/*
!uploads/.gitkeep
*.pdf
!samples/*.pdf

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/