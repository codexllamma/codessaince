# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Google Programmable Search, used by services/image_fetcher.py to pull a
# background still for each scene. Entirely optional: with these unset the
# pipeline runs exactly as before and scenes use the procedural gradient.
#
# Setup:
#   1. console.cloud.google.com -> new project -> enable "Custom Search API"
#   2. APIs & Services -> Credentials -> Create Credentials -> API Key
#      Restrict the key to Custom Search API while you are there.
#   3. programmablesearchengine.google.com -> Add -> "Search the entire web"
#   4. Turn Image search ON (it is off by default) and copy the Search engine ID
#
# Free tier is 100 queries/day. Search results are cached on disk under
# assets/broll/.search_cache, so repeated renders of the same scenes cost
# nothing — only genuinely new queries spend quota.

GOOGLE_API_KEY=
SEARCH_ENGINE_ID=
