# Repo-root ignores.
#
# The backend was moved under backend/ when the frontend subtree landed, and
# its .gitignore went with it — leaving the root uncovered. Without this file
# the virtualenv, caches and generated media at the root are all candidates
# for commit. backend/.gitignore and frontend/*/.gitignore still cover their
# own trees; this only catches what sits above them.

# Virtual environments & Python cache
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# Binary Executables & Large Model Weights (>50MB / >100MB)
*.exe
*.pth
*.pt
*.onnx
*.bin
*.tar
*.zip
backend/ffmpeg.exe
backend/gfpgan/weights/
backend/services/wav2lip/checkpoints/
backend/services/wav2lip/face_detection/detection/sfd/*.pth
backend/services/wav2lip/gfpgan/weights/

# Node
node_modules/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Generated at the old root paths before the backend/ move; the app now
# writes these under backend/ instead. Anchored with a leading slash so they
# match only at the repo root — an unanchored "static/" would also swallow
# backend/static/, which backend/.gitignore governs deliberately.
/out/
/jobs/
/logs/
/static/
/temp/
/tmp/

# Generated media (un-ignore backend static assets and deliverables)
!backend/static/videos/**
!backend/static/audio/**
!backend/static/avatars/**
!backend/static/font_tests/**
!backend/assets/fonts/**
!backend/assets/avatars/**

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
